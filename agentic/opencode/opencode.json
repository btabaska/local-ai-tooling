{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab AI (LiteLLM on rig)",
      "options": {
        "baseURL": "https://llm.tabaska.us/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "coder": {
          "name": "coder - Qwen3.6 35B-A3B MoE (default; 131k ctx)",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "coder-strong": {
          "name": "coder-strong - Qwen3.6 27B MTP (~50 t/s, 98k ctx)",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 98304,
            "output": 8192
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "fast": {
          "name": "fast - Qwen2.5-Coder 7B (quick/cheap)",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "utility": {
          "name": "utility - Llama3.2 3B (titles/tags)",
          "tool_call": false,
          "temperature": true
        }
      }
    },
    "llamaswap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab AI (llama-swap DIRECT - A/B lane, no gateway)",
      "options": {
        "baseURL": "http://192.168.10.12:9292/v1",
        "apiKey": "not-required-llama-swap-is-unauthenticated"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "DIRECT coder - Qwen3.6 35B-A3B MoE",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "qwen3.6-27b": {
          "name": "DIRECT coder-strong - Qwen3.6 27B MTP",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 98304,
            "output": 8192
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "qwen2.5-coder-7b": {
          "name": "DIRECT fast - Qwen2.5-Coder 7B",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "litellm/coder",
  "small_model": "litellm/utility",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "lsp": true,
  "formatter": true,
  "agent": {
    "build": {
      "mode": "primary",
      "model": "litellm/coder",
      "temperature": 0.6,
      "top_p": 0.95,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "rm -rf*": "ask",
          "sudo*": "ask"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "litellm/coder-strong",
      "temperature": 0.6,
      "top_p": 0.95,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "serena-agent==1.6.1",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--enable-web-dashboard",
        "false",
        "--project",
        "{cwd}"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
