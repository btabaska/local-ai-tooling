{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "opencode-plugin-litellm@0.8.0",
    "cc-safety-net@1.0.6",
    "@tarquinen/opencode-dcp@3.1.14",
    "opencode-notify@0.3.1",
    "opencode-ntfy.sh@1.1.0",
    "opencode-token-tracker@1.7.1"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab AI (LiteLLM on rig)",
      "options": {
        "baseURL": "https://llm.tabaska.us/v1",
        "apiKey": "{env:LITELLM_API_KEY}",
        "timeout": 900000,
        "headerTimeout": 180000,
        "chunkTimeout": 300000
      },
      "models": {
        "q38": {
          "name": "q38 - Qwen3.8 27B MTP (sole coding/agentic lane)",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 245760,
            "output": 8192
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "utility": {
          "name": "utility - Llama3.2 3B (titles/tags)",
          "tool_call": false,
          "temperature": true,
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    },
    "llamaswap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Homelab AI (llama-swap DIRECT - A/B lane, no gateway)",
      "options": {
        "baseURL": "http://192.168.10.12:9292/v1",
        "apiKey": "not-required-llama-swap-is-unauthenticated",
        "timeout": 900000,
        "headerTimeout": 180000,
        "chunkTimeout": 300000
      },
      "models": {
        "qwen3.8-27b": {
          "name": "DIRECT q38 - Qwen3.8 27B MTP",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 245760,
            "output": 8192
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  },
  "model": "litellm/q38",
  "small_model": "litellm/utility",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "lsp": true,
  "formatter": true,
  "agent": {
    "build": {
      "mode": "primary",
      "model": "litellm/q38",
      "temperature": 0.6,
      "top_p": 0.95,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "rm -rf*": "ask",
          "sudo*": "ask"
        }
      },
      "tools": {
        "serena*": true,
        "context7*": true,
        "fleet*": true,
        "playwright*": true,
        "comfyui*": true,
        "openzim*": true,
        "openstreetmap*": true,
        "memos*": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "litellm/q38",
      "temperature": 0.6,
      "top_p": 0.95,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "tools": {
        "serena*": true,
        "context7*": true,
        "fleet*": true,
        "playwright*": true,
        "comfyui*": true,
        "openzim*": true,
        "openstreetmap*": true,
        "memos*": true
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp",
      "timeout": 20000
    },
    "fleet": {
      "type": "remote",
      "enabled": true,
      "url": "http://cachyos.tailb31641.ts.net:8765/mcp",
      "timeout": 15000
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "serena-agent==1.6.1",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--enable-web-dashboard",
        "false",
        "--project",
        "{cwd}"
      ],
      "environment": {
        "PYTHONUNBUFFERED": "1"
      },
      "timeout": 30000
    },
    "playwright": {
      "type": "remote",
      "enabled": true,
      "url": "http://cachyos.tailb31641.ts.net:8931/mcp",
      "timeout": 20000
    },
    "comfyui": {
      "type": "remote",
      "enabled": true,
      "url": "http://cachyos.tailb31641.ts.net:9000/mcp",
      "timeout": 20000
    },
    "openzim": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "openzim-mcp==2.5.5",
        "--mode",
        "advanced",
        "/mnt/nas-zim"
      ],
      "timeout": 30000
    },
    "openstreetmap": {
      // lai-17: cyanheads/openstreetmap-mcp-server@0.3.6 (pinned). 6 tools
      // (search_places/reverse_geocode/lookup_objects/query_nearby/query_bbox/
      // query_raw) over PUBLIC OSM Nominatim + Overpass. The offline Photon
      // geocoder (maps.tabaska.us) is NOT Nominatim-API-compatible, so the map
      // viewer consumes Photon directly and this MCP stays the ONLINE OSM
      // enrichment tool. opencode-NATIVE only: mcpo can't bridge it (its pinned
      // container Node 22 < the server's required Node >=24) and it is NOT in
      // OWUI, so the OWUI visible-tool budget stays 40/40.
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@cyanheads/openstreetmap-mcp-server@0.3.6"],
      "environment": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "OSM_USER_AGENT": "going-analogue-homelab/1.0 (lai-17)"
      },
      "timeout": 30000
    },
    "memos": {
      // journal-09: the Memos journal's BUILT-IN MCP server on the mini
      // (in Memos since 0.27; 19 tools — search/create/update/delete memos,
      // comments, attachments, reactions, tags). Bearer PAT = vault
      // journaling.memos.mcp_token, exported as MEMOS_MCP_TOKEN from the
      // shell env (rig ~/.bashrc, Mac ~/.zshenv — same pattern as
      // LITELLM_API_KEY). opencode gets the FULL tool set (unlike OWUI chat,
      // which filters to search_memos+create_memo); destructive ops are
      // gated by the usual edit/bash ask-permissions posture.
      "type": "remote",
      "enabled": true,
      "url": "http://macmini.tailb31641.ts.net:5230/mcp",
      "headers": {
        "Authorization": "Bearer {env:MEMOS_MCP_TOKEN}"
      },
      "timeout": 15000
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "tools": {
    "serena*": false,
    "context7*": false,
    "fleet*": false,
    "playwright*": false,
    "comfyui*": false,
    "openzim*": false,
    "openstreetmap*": false,
    "memos*": false
  },
  "subagent_depth": 2,
  "compaction": {
    "prune": true
  },
  "tool_output": {
    "max_lines": 600
  }
}
