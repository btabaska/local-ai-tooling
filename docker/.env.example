# ── docker/.env ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Generate each secret with:  openssl rand -hex 32
#
# AI_HOST is only used in printed URLs / your notes. The containers reach Ollama on the
# host via host.docker.internal (configured in docker-compose.yml), so you don't need to
# hardcode the IP for them — but set it so the stack can tell you your endpoints.
AI_HOST=cachybox.local

# Tailscale MagicDNS name of THIS box (run: tailscale status). ONLY needed if you start the
# bundled Caddy (the "caddy" compose profile) for *.ts.net HTTPS. If you front Open WebUI with
# your own reverse proxy (e.g. Caddy on your NAS), you can ignore this and set WEBUI_URL below.
# Example: cachybox.tailnet-abcd.ts.net
TS_HOSTNAME=cachybox.tailnet-abcd.ts.net

# ── LiteLLM ──────────────────────────────────────────────────────────────────
# Admin/master key. MUST start with sk-. Used to log into the LiteLLM UI and mint virtual keys.
LITELLM_MASTER_KEY=sk-CHANGE-ME-master-xxxxxxxxxxxxxxxxxxxxxxxx
# Encrypts stored credentials in the DB. ⚠️ CANNOT be changed after you add models — pick once.
LITELLM_SALT_KEY=sk-CHANGE-ME-salt-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Postgres (backs LiteLLM virtual keys + spend tracking) ──────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE-ME-db-password
POSTGRES_DB=litellm

# ── Open WebUI ───────────────────────────────────────────────────────────────
# External URL Open WebUI advertises (login redirects, absolute links, PWA). Set to the hostname
# you actually reach it on. Leave blank to default to https://$TS_HOSTNAME (bundled-Caddy path).
WEBUI_URL=https://ai.example.com   # e.g. https://ai.tabaska.us if you front it from your NAS Caddy

# ⚠️ Keep this STABLE. If it changes across restarts, Open WebUI can't decrypt saved
# tool/OAuth credentials and external tools break with "Error decrypting tokens".
WEBUI_SECRET_KEY=CHANGE-ME-webui-secret-xxxxxxxxxxxxxxxxxxxx
