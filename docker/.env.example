# ── docker/.env ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Generate each secret with:  openssl rand -hex 32
#
# KEY PARITY + VAULT MAP (ai-04, 2026-07-29): every live docker/.env key is listed
# here as a NAME with a placeholder — NO real secret values live in this file.
# The trailing `-> vault <path>` comment on each secret is its durable second source
# in foss-setup/.handoff-secrets.yaml, so a rig-disk loss is never a secret loss.
# Keys marked "non-secret" / "regenerable" are config or derivable and intentionally
# not vaulted. Keep this file at full key parity with .env (env-key-parity check).
#
# AI_HOST is only used in printed URLs / your notes (scripts/healthcheck.sh). The
# containers reach Ollama on the host via host.docker.internal (configured in
# docker-compose.yml), so you don't need to hardcode the IP for them — but set it so
# the stack can tell you your endpoints.
AI_HOST=cachybox.local                       # non-secret host identity; not vaulted

# Tailnet hostname (only referenced by the deprecated docker/Caddyfile.deprecated).
TS_HOSTNAME=cachyos.tailnet-name.ts.net      # non-secret; regenerable from `tailscale status`; not vaulted

# ── LiteLLM ──────────────────────────────────────────────────────────────────
# Admin/master key. MUST start with sk-. Used to log into the LiteLLM UI and mint virtual keys.
LITELLM_MASTER_KEY=sk-CHANGE-ME-master-xxxxxxxxxxxxxxxxxxxxxxxx   # -> vault litellm.master_key
# Encrypts stored credentials in the DB. ⚠️ CANNOT be changed after you add models — pick once.
LITELLM_SALT_KEY=sk-CHANGE-ME-salt-xxxxxxxxxxxxxxxxxxxxxxxxxxxx   # -> vault litellm.salt_key

# ── Postgres (backs LiteLLM virtual keys + spend tracking) ──────────────────
POSTGRES_USER=litellm                        # non-secret default; not vaulted
POSTGRES_PASSWORD=CHANGE-ME-db-password      # -> vault litellm.postgres_password
POSTGRES_DB=litellm                          # non-secret default; not vaulted

# ── Open WebUI ───────────────────────────────────────────────────────────────
# External URL Open WebUI advertises (login redirects, absolute links, PWA). Set to the HTTPS
# hostname your reverse proxy uses (e.g. https://ai.example.com). Leave blank for plain HTTP.
WEBUI_URL=https://ai.example.com             # -> vault open_webui.url (non-secret public URL)

# ⚠️ Keep this STABLE. If it changes across restarts, Open WebUI can't decrypt saved
# tool/OAuth credentials and external tools break with "Error decrypting tokens".
WEBUI_SECRET_KEY=CHANGE-ME-webui-secret-xxxxxxxxxxxxxxxxxxxx     # -> vault open_webui.secret_key

# Web search (Kagi). Seeds a FRESH open_webui_data volume only — the DB is authoritative
# once set (PersistentConfig). Get a key at https://kagi.com/settings?p=api
KAGI_SEARCH_API_KEY=CHANGE-ME-kagi-api-key   # -> vault ai_stack.kagi_search_api_key

# LiteLLM virtual key Open WebUI uses to reach LiteLLM (compose maps it to the container's
# OPENAI_API_KEY + RAG_OPENAI_API_KEY). Mint with the master key.
OPENWEBUI_LITELLM_KEY=sk-CHANGE-ME-litellm-virtual-key           # -> vault ai_stack.litellm_openwebui_key

# ── Host dir mounted into mcpo at /repos so serena can reach your repos ───────
# (each subdir -> /repos/<name>).
REPOS_PATH=/home/you/Documents/GitHub        # non-secret host path; not vaulted

# ── Operator-convenience shell vars (NOT consumed by compose) ────────────────
# So you can `set -a; . ./.env` and point OpenAI-compatible CLIs at LiteLLM.
OPENAI_API_BASE_URL=http://localhost:4000/v1 # non-secret; regenerable (= your LiteLLM URL); not vaulted
OPENAI_API_KEY=sk-CHANGE-ME-litellm-virtual-key                 # alias of OPENWEBUI_LITELLM_KEY -> vault ai_stack.litellm_openwebui_key

# ── Creative/RP frontends (added 2026-07-18): lumiverse + marinara-engine ───────
# Both are self-hosted chat UIs pointed at LiteLLM. Their OpenAI-compatible connection
# is created IN-APP (no env for base_url/key/model), so the *_LITELLM_KEY vars below are
# NOT consumed by compose — they're recorded here + in the vault (ai_stack.*) and typed
# into each app's connection form: API URL http://litellm:4000/v1, key = the value below.
# Both keys are LiteLLM virtual keys scoped to cydonia/dolphin-venice/goetia (the only
# model restriction — neither app has a server-side allowlist). Generate with the master
# key: curl .../key/generate -d '{"models":["cydonia","dolphin-venice","goetia"],...}'.
LUMIVERSE_LITELLM_KEY=sk-CHANGE-ME-litellm-virtual-key          # -> vault ai_stack.litellm_lumiverse_key
MARINARA_LITELLM_KEY=sk-CHANGE-ME-litellm-virtual-key           # -> vault ai_stack.litellm_marinara_key

# ── Coding agents (ai-09): pi / opencode / Orca-launched agents ──────────────
# LiteLLM virtual key scoped to coder/coder-strong/fast/utility, used by the local
# coding agents (pi + opencode) that Orca orchestrates. NOT consumed by compose —
# it lives here so the rig has ONE canonical source; ~/.bashrc + ~/.bash_profile
# export it as LITELLM_API_KEY, which pi's auth.json ("$LITELLM_API_KEY") and
# opencode.json ("{env:LITELLM_API_KEY}") read. Mint with the master key:
#   curl .../key/generate -d '{"models":["coder","coder-strong","fast","utility"],...}'
# See clients/ (opencode.json, pi-models.json, pi-auth.example.json, README.md).
CODING_LITELLM_KEY=sk-CHANGE-ME-litellm-virtual-key             # -> vault ai_stack.litellm_coding_key

# Lumiverse owner/admin account (min 8 chars). openssl rand -hex 16
LUMIVERSE_OWNER_PASSWORD=CHANGE-ME-lumiverse-owner-pw           # -> vault ai_stack.lumiverse_owner_password

# Marinara-Engine auth + secrets. Basic Auth gates every non-loopback client (incl. the
# reverse proxy, via REQUIRE_AUTH_FOR_DOCKER_PROXY=true in compose). Generate the rest
# with openssl rand -hex 16 / -hex 32.
MARINARA_BASIC_AUTH_USER=marinara            # -> vault ai_stack.marinara_basic_auth_user
MARINARA_BASIC_AUTH_PASS=CHANGE-ME-marinara-basic-pw           # -> vault ai_stack.marinara_basic_auth_pass
MARINARA_ADMIN_SECRET=CHANGE-ME-marinara-admin-secret-hex32    # -> vault ai_stack.marinara_admin_secret
MARINARA_ENCRYPTION_KEY=CHANGE-ME-marinara-encryption-key-hex32 # -> vault ai_stack.marinara_encryption_key

# ── local-deep-research (lai-08) ─────────────────────────────────────────────
# Scoped LiteLLM virtual key (coder-strong/fast) — compose maps it to the LDR
# container's LDR_LLM_OPENAI_ENDPOINT_API_KEY. Mint with the master key:
#   curl .../key/generate -d '{"models":["coder-strong","fast"],...}'
LDR_LITELLM_KEY=sk-CHANGE-ME-litellm-virtual-key             # -> vault ai_stack.litellm_ldr_key
# Dedicated LDR account driving the daily ldr-research-e2e check (LDR accounts are
# per-user encrypted SQLCipher DBs; this one is disposable, made via /auth/register).
LDR_PROBE_USER=ldr-probe                     # non-secret account name; not vaulted
LDR_PROBE_PASSWORD=CHANGE-ME-ldr-probe-pw                    # -> vault ai_stack.ldr_probe_password

# ── Open Terminal code-exec backend (lai-09, 2026-08-06) ────────────────────
# OWUI terminal-server connection -> the mini's open-terminal sandbox (host
# 192.168.10.2:8020, stack /opt/stacks/open-terminal; server-side code exec
# replacing browser Pyodide — in OWUI 0.10.x this is the terminal-server
# integration, NOT the CODE_EXECUTION_ENGINE knob, which only knows
# pyodide|jupyter). PersistentConfig: the DB is authoritative once set — the
# seed below re-wires a FRESH open_webui_data volume only (kept commented in
# the live .env too; compose passes it through with a safe '[]' default).
# Canonical wiring lives in the DB via POST /api/v1/configs/terminal_servers;
# the JSON 'key' field is the open-terminal Bearer key -> vault open_terminal.api_key
#TERMINAL_SERVER_CONNECTIONS=[{"id":"open-terminal","name":"Open Terminal (mini)","enabled":true,"url":"http://192.168.10.2:8020","path":"/openapi.json","key":"CHANGE-ME-open-terminal-api-key","auth_type":"bearer","config":null,"server_type":"terminal"}]

# ── TriliumNext ETAPI for trilium-mcp (lai-16) ─────────────
# ETAPI token for the rig mcpo trilium-mcp bridge (OVDEN13 v0.1.5, read-mostly)
# against the mini Trilium trial. Passed into the mcpo container env + inherited
# by the trilium-mcp stdio subprocess as TRILIUM_TOKEN (compose also sets
# TRILIUM_URL=https://trilium.tabaska.us). Retires with the Trilium trial.
TRILIUM_ETAPI_TOKEN=CHANGE-ME-trilium-etapi-token           # -> vault trilium.etapi_token
